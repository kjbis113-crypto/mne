# Server-only Netlify environment variables; include Functions scope.
# Never commit real values or use a VITE_ prefix.
MNE_ORDER_WEBHOOK_URL=
MNE_ORDER_SECRET=
MNE_ADMIN_TOKEN=

# Off until a matching TossPayments API key pair is configured.
MNE_PAYMENT_ENABLED=false
MNE_TOSS_CLIENT_KEY=
MNE_TOSS_SECRET_KEY=

# Live payments also require reviewed policies and complete merchant details.
MNE_POLICIES_READY=false
MNE_MERCHANT_INFO={"businessName":"","representative":"","businessNumber":"","commerceNumber":"","address":"","supportPhone":"","supportEmail":"","privacyOfficer":""}
MNE_SHIPPING_ESTIMATE=
